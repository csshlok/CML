# CML local development configuration template.

CML_DATA_DIR=data
CML_DATABASE_PATH=data/cml.sqlite3
CML_MODELS_DIR=data/models
CML_API_PREFIX=/api/v1

# Desktop dev UI.
# Use 7343 when 7342 is occupied by a stale local process during development.
VITE_CML_BACKEND_URL=http://127.0.0.1:7343

# Local synthesis runtime.
# Options for CML_LLM_PROVIDER:
# - none
# - openai-compatible
# - llama.cpp
# - ollama
#
# The current backend calls an OpenAI-compatible /v1/chat/completions endpoint.
CML_LLM_PROVIDER=none
CML_LLM_BASE_URL=http://127.0.0.1:8084/v1
CML_LLM_MODEL=cml-local
CML_LLM_TIMEOUT_SECONDS=45

# Local embeddings.
# Default `hash` is dependency-light. Use `sentence-transformers` after installing
# the optional Python package and downloading/allowing the model locally.
CML_EMBEDDING_PROVIDER=hash
CML_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CML_EMBEDDING_DIMENSIONS=384
CML_EMBEDDING_CACHE_DIR=
