{
  "name": "cml",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "backend": ".venv\\Scripts\\python -m uvicorn backend.app.main:app --host 127.0.0.1 --port 7343",
