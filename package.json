{
  "name": "cml",
  "version": "0.1.11",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\backend\\start-dev-backend.ps1",
    "dev": "npm run dev --workspace @cml/desktop",
    "dev:web": "npm run dev:web --workspace @cml/desktop",
    "build": "npm run build --workspace @cml/desktop",
    "lint": "npm run lint --workspace @cml/desktop",
    "test:backend": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\backend\\run-tests.ps1 -Tier quick",
    "test:backend:full": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\backend\\run-tests.ps1 -Tier full",
    "package:win:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\packaging\\check-windows-dev-build.ps1",
    "package:win": "npm run package:win --workspace @cml/desktop",
    "security:renderer": "node scripts/security/audit-renderer-html-safety.mjs",
    "audit:controls": "node scripts/ui/audit-interactive-controls.mjs",
    "security:package": "node scripts/packaging/generate-helper-manifest.cjs && node scripts/packaging/audit-package-layout.cjs apps/desktop/packaging apps/desktop/packaging",
    "security:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\security\\run-security-e2e.ps1"
  }
}
